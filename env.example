# Copy this file to .env and fill in as needed
# Variables not prefixed with UV_ or VIRTUAL_ENV are passed to the environment.

# --- Optional: API keys for LLM feature extraction (Task 3) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- Data collection settings (Task 1) ---
# OSM_BOUNDING_BOX=55.55,37.35,55.95,37.95   # format: min_lat,min_lon,max_lat,max_lon
# OSM_POIS_PER_CATEGORY=12

# --- Offline mode (for tests without network) ---
# OFFLINE_MODE=true
# OFFLINE_CSV=data/poi_dataset_raw.csv
